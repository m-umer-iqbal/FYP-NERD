{
    "manifest_version": 3,
    "name": "NERD",
    "version": "6.0.0",
    "description": "NERD - Next-gen Extension for Rapid Development",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "alarms",
        "contextMenus"
    ],
    "host_permissions": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "http://[::1]/*",
        "https://[::1]/*"
    ],
    "content_scripts": [
        {
            "matches": [
                "http://localhost/*",
                "https://localhost/*",
                "http://127.0.0.1/*",
                "https://127.0.0.1/*",
                "http://[::1]/*",
                "https://[::1]/*"
            ],
            "run_at": "document_idle",
            "js": [
                "./src/scripts/LocalFormSaver.js"
            ]
        },
        {
            "matches": [
                "http://localhost/*",
                "https://localhost/*",
                "http://127.0.0.1/*",
                "https://127.0.0.1/*",
                "http://[::1]/*",
                "https://[::1]/*"
            ],
            "run_at": "document_end",
            "js": [
                "./src/scripts/WebsiteAuditor.js",
                "./src/scripts/DebuggingAssistant.js"
            ]
        }
    ],
    "background": {
        "service_worker": "./src/scripts/DebuggingAssistant-Background.js",
        "type": "module"
    },
    "web_accessible_resources": [
        {
            "matches": [
                "http://localhost/*",
                "https://localhost/*",
                "http://127.0.0.1/*",
                "https://127.0.0.1/*",
                "http://[::1]/*",
                "https://[::1]/*"
            ],
            "resources": [
                "page-monitor.js"
            ]
        }
    ],
    "action": {
        "default_popup": "index.html"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}